{
  "version": 1,
  "sdk_version": "0.25.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://qbzldcftrcgrjfwtdqpu.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "superapa",
      "version": "0.1.0",
      "title": "SuperApa"
    },
    "tools": [
      {
        "name": "get_fleet_summary",
        "title": "Get fleet summary",
        "description": "Overall totals for the vehicle Dagger: total miles, gallons, fuel cost, fill-ups, average price per gallon and MPG.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_monthly_totals",
        "title": "Get monthly totals",
        "description": "Monthly and annual totals (miles, gallons, fuel cost, MPG, fill-ups, trips) for Dagger, grouped by year.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "year": {
              "description": "Optional year filter, e.g. 2025.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_trips",
        "title": "List trip / fuel log entries",
        "description": "List individual fuel log entries for Dagger (date, miles, gallons, price per gallon, cost, trip, notes), newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "description": "Max entries to return. Defaults to 25.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "from": {
              "description": "Only entries on or after this ISO date (YYYY-MM-DD).",
              "type": "string"
            },
            "to": {
              "description": "Only entries on or before this ISO date (YYYY-MM-DD).",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
